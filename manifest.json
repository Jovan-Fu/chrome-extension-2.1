{
  "manifest_version": 3,
  "name": "智能截图助手 Pro",
  "version": "2.1",
  "description": "支持 Facebook、YouTube、Instagram、TikTok、Pinterest 等多平台一键截图，自动保存至 Google Drive 并同步 Google Sheets",
  "permissions": [
    "activeTab",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.facebook.com/*",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.pinterest.com/*",
    "https://*.pinterest.co.uk/*",
    "https://*.behance.net/*",
    "https://*.dribbble.com/*",
    "https://*.flickr.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://api.ocr.space/*",
    "https://api.groq.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.youtube.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.pinterest.com/*",
        "https://*.pinterest.co.uk/*",
        "https://*.behance.net/*",
        "https://*.dribbble.com/*",
        "https://*.flickr.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
